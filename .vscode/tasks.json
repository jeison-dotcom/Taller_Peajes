{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++-13 compilar proyecto",
            "command": "/usr/bin/g++-13",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-I${workspaceFolder}/include",
                "${workspaceFolder}/Src/main.cpp",
                "${workspaceFolder}/Src/Carro.cpp",
                "${workspaceFolder}/Src/Caseta.cpp",
                "${workspaceFolder}/Src/Persona.cpp",
                "${workspaceFolder}/Src/Propietario.cpp",
                "${workspaceFolder}/Src/Registro.cpp",
                "${workspaceFolder}/Src/Vehiculo.cpp",
                "-o",
                "${workspaceFolder}/Taller_Peajes"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Tarea generada por el depurador."
        }
    ],
    "version": "2.0.0"
}